{
  "name": "browser-plugin-workbench",
  "version": "0.2.0",
  "private": true,
  "description": "Small local workbench that prepares real browser-plugin development environments for AI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moshouhot/browser-plugin-workbench.git"
  },
  "homepage": "https://github.com/moshouhot/browser-plugin-workbench#readme",
  "bugs": {
    "url": "https://github.com/moshouhot/browser-plugin-workbench/issues"
  },
  "files": [
    "bin/bpw.js",
    "tools/config.js",
    "tools/dev-server-control.js",
    "tools/dev-server.js",
    "tools/generate-userscript-loader.js",
    "tools/source-identity.js",
    "tools/tampermonkey.js",
    "tools/violentmonkey.js",
    "tools/start-browser.ps1",
    "targets/userscript/main.user.js",
    "workbench.config.json"
  ],
  "bin": {
    "bpw": "bin/bpw.js"
  },
  "scripts": {
    "bpw": "node bin/bpw.js",
    "prepare:userscript": "node tools/generate-userscript-loader.js",
    "dev": "node tools/dev-server.js",
    "dev:start": "node tools/dev-server-control.js start",
    "dev:status": "node tools/dev-server-control.js status",
    "dev:stop": "node tools/dev-server-control.js stop",
    "browser": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/start-browser.ps1",
    "browser:verify": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/verify-browser.ps1",
    "check": "node tools/selftest.js",
    "test": "node tools/generate-userscript-loader.js && node tools/smoke-test.js && node tools/cli-test.js && node tools/violentmonkey-test.js && node tools/tampermonkey-test.js"
  },
  "engines": {
    "node": ">=20"
  }
}
